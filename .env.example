# Hyperlicked Server Configuration

# Mode: dev (default), testnet, mainnet
MODE=dev

# Server
PORT=8080

# Logging (error, warn, info, debug, trace)
RUST_LOG=info

# Consensus
BLOCK_TIME_MS=100
CONSENSUS_LOOP_DELAY_MS=10  # Delay between consensus rounds (0 = max speed)
LOG_BLOCKS=true

# Development (only applies in dev mode)
DEV_FAUCET_AMOUNT=10000000  # $100,000 in cents for new accounts
# SKIP_SIG_VERIFY=true      # Skip signature verification (unsafe!)
ORACLE_ENABLED=true

# Market Maker (dev mode only)
# MM_ENABLED=true           # Enable artificial market maker
# MM_INTERVAL_MS=100        # Interval between MM ticks
# MM_INTENSITY=medium       # Preset: low (showcase), medium, high (stress)
# MM_SEED=12345             # RNG seed for deterministic addresses