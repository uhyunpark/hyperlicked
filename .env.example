# Hyperlicked environment reference
#
# The recommended local command is:
#   ./scripts/local-node
#
# That launcher already exports MODE=dev and the public validator-0 fixture
# seed. This file is documentation only: hl-node does not automatically load
# .env files, so export a value in your shell when overriding it.

# hl-node currently accepts only dev mode. Testnet/mainnet startup is disabled.
MODE=dev

# Logging. scripts/local-node defaults to warn; use info to see consensus rounds.
RUST_LOG=info

# Small delay between consensus rounds. Zero can consume a full CPU core.
CONSENSUS_LOOP_DELAY_MS=10

# Local dev faucet amount in integer cents ($100,000.00).
DEV_FAUCET_AMOUNT=10000000

# Gossip is enabled by default. The N=1 fixture has no peers to relay to.
GOSSIP_ENABLED=true

# Optional mempool limits.
MEMPOOL_MAX_PER_BUCKET=10000
MEMPOOL_MAX_PER_ADDRESS=100
MEMPOOL_MAX_AGE_MS=3600000

# Optional admin address for authenticated governance transactions.
# ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# Never enable signature/QC bypasses during normal local testing.
# SKIP_SIG_VERIFY=true
# SKIP_QC_VERIFY=true

# Consensus/API addresses and peer identities belong in config/local node JSON.
# Use the explicit --data-dir and --sync-peer CLI flags for persistence and
# verified bootstrap. Legacy PORT, PEERS, BLOCK_TIME_MS, LOG_BLOCKS,
# ORACLE_ENABLED, and MM_ENABLED values do not create separate services or
# mutation loops in the canonical hl-node runtime.

# Validator BLS seed variables are deliberately omitted. scripts/local-node
# and docker-compose.validator4.yml inject public development fixtures. Never
# reuse those values for testnet or mainnet.
